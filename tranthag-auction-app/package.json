{
  "name": "tranthag-auto-auction",
  "version": "3.0.0",
  "description": "TranThag TikTok LIVE Auto Auction",
  "main": "main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "tiktok-live-connector": "2.3.0-beta1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tranthag.autoauction",
    "productName": "TranThagAPPLIVE Auto Auction",
    "asar": true,
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "TranThagAPPLIVE_AutoAuction.exe"
    }
  }
}