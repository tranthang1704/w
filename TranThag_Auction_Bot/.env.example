TIKTOK_USERNAME=your_tiktok_username
HOST=127.0.0.1
PORT=3000

MIN_GIFT_COINS=100
MAIN_SECONDS=50
FINAL_SECONDS=25
FINAL_RESET_SECONDS=30
NEXT_ROUND_DELAY_SECONDS=5

# Local transparent simulation only.
# Dummy bidders are disabled automatically while TikTok LIVE is connected.
SIMULATION_MODE=false
DUMMY_BIDDER_ENABLED=false
DUMMY_FOLLOW_TEST_BIDS=true
DUMMY_AUTO_NO_BID_SECONDS_LEFT=10
DUMMY_PUSH_STEP_COINS=100

ROBLOX_DELIVERY_ENABLED=false
ROBLOX_DRY_RUN=true
ROBLOX_UNIVERSE_ID=
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_TOPIC=auction-awards-v1

ADMIN_TOKEN=change-me
ALLOW_TEST_API=false
